{
  "name": "localdev-ai",
  "displayName": "LocalDev AI",
  "description": "A learning-focused local coding assistant for Python development.",
  "version": "0.0.1",
  "publisher": "localdev-ai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:localdev-ai.helloWorld"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "localdev-ai.helloWorld",
        "title": "LocalDev AI: Hello World"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2"
  }
}
