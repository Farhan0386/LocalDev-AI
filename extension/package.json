{
  "name": "localdev-ai",
  "displayName": "LocalDev AI",
  "description": "A learning-focused local coding assistant for Python development.",
  "version": "0.0.1",
  "publisher": "localdev-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Farhan0386/LocalDev-AI.git"
  },
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:localdev-ai.chatView",
    "onCommand:localdev-ai.openChat",
    "onCommand:localdev-ai.helloWorld",
    "onCommand:localdev-ai.checkHardware",
    "onCommand:localdev-ai.toggleAutocomplete"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localdev-ai-sidebar",
          "title": "LocalDev AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localdev-ai-sidebar": [
        {
          "type": "webview",
          "id": "localdev-ai.chatView",
          "name": "LocalDev AI Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "localdev-ai.openChat",
        "title": "LocalDev AI: Open Interactive Chat"
      },
      {
        "command": "localdev-ai.newChat",
        "title": "LocalDev AI: New Chat Session"
      },
      {
        "command": "localdev-ai.helloWorld",
        "title": "LocalDev AI: Hello World"
      },
      {
        "command": "localdev-ai.refreshModels",
        "title": "LocalDev AI: Refresh Ollama Models"
      },
      {
        "command": "localdev-ai.checkHardware",
        "title": "LocalDev AI: Check Hardware and Model Fit"
      },
      {
        "command": "localdev-ai.selectModel",
        "title": "LocalDev AI: Select Ollama Model"
      },
      {
        "command": "localdev-ai.explainCode",
        "title": "LocalDev AI: Explain Selected Python Code"
      },
      {
        "command": "localdev-ai.explainTraceback",
        "title": "LocalDev AI: Explain Python Traceback"
      },
      {
        "command": "localdev-ai.proposePatch",
        "title": "LocalDev AI: Propose Minimal Python Patch"
      },
      {
        "command": "localdev-ai.toggleAutocomplete",
        "title": "LocalDev AI: Toggle Tab Autocomplete"
      }
    ]
  },
  "configuration": {
    "title": "LocalDev AI",
    "properties": {
      "localdev-ai.ollamaEndpoint": {
        "type": "string",
        "default": "http://127.0.0.1:11434",
        "description": "Ollama server endpoint used by the local Python engine."
      },
      "localdev-ai.ollamaTimeoutSeconds": {
        "type": "number",
        "default": 5,
        "minimum": 0.1,
        "description": "Ollama connection timeout in seconds."
      },
      "localdev-ai.selectedModel": {
        "type": "string",
        "default": "",
        "description": "Installed Ollama model selected for future inference."
      },
      "localdev-ai.hintOnly": {
        "type": "boolean",
        "default": false,
        "description": "Ask the local model to provide hints before complete answers."
      },
      "localdev-ai.maxRenderedMessages": {
        "type": "number",
        "default": 100,
        "minimum": 20,
        "maximum": 200,
        "description": "Maximum chat messages rendered in the sidebar DOM to limit memory use."
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "stage-engine": "node scripts/stage-engine.js",
    "package": "npm run compile && npm run stage-engine && vsce package --no-dependencies",
    "test": "npm run compile && node --test tests/*.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.146.0",
    "@vscode/vsce": "^3.6.1",
    "typescript": "^5.3.2"
  }
}
